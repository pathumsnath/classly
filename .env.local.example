# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Auth -> Hooks -> Send SMS hook -> secret (format: v1,whsec_...)
SUPABASE_AUTH_HOOK_SECRET=

# Notify.lk (Sri Lankan SMS gateway). Leave blank to use the console-log SMS stub.
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs admin-staff set-password invite links. Generate with:
#   openssl rand -base64 32
INVITE_TOKEN_SECRET=
